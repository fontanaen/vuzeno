{
  "name": "vuzeno",
  "type": "module",
  "scripts": {
    "lint": "biome check ./apps/docs ./packages/registry",
    "lint:fix": "biome check --write ./apps/docs ./packages/registry",
    "lint:ci": "biome ci ./apps/docs ./packages/registry",
    "lint:check": "biome check ./apps/docs ./packages/registry",
    "lint:format": "biome format --write ./apps/docs ./packages/registry",
    "playground:dev": "bun run --filter=@vuzeno/playground dev",
    "docs:dev": "bun run --filter=@vuzeno/docs dev",
    "docs:preview": "bun run --filter=@vuzeno/docs preview",
    "docs:preview:cf": "bun run --filter=@vuzeno/docs preview:cf",
    "docs:build": "bun run --filter=@vuzeno/docs build",
    "docs:deploy": "bun run --filter=@vuzeno/docs deploy",
    "registry:build": "bun run --filter=@vuzeno/cli build",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "tools/*"
    ],
    "catalog": {
      "cnfast": "^0.0.8",
      "tw-animate-css": "^1.4.0",
      "tailwindcss": "^4.1.11",
      "tailwindcss-animate": "^1.0.7",
      "@vueuse/core": "^14.1.0",
      "@ark-ui/vue": "5.37.2",
      "reka-ui": "2.9.2",
      "vue": "3.5.39",
      "@internationalized/date": "^3.10.1",
      "libphonenumber-js": "^1.12.34"
    }
  },
  "overrides": {
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "6.0.2",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "shadcn-vue": "^2.4.3"
  }
}
